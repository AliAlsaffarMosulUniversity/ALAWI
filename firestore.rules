rules_version = '2';

// قواعد حماية قاعدة بيانات رئاسة القسم الذكية.
// القراءة لأي حساب جامعي موثّق (@uomosul.edu.iq)، والكتابة لرئيس القسم والمشرفين المسجلين في config/admins.
// التدريسي يكتب فقط تأكيد قراءته للتبليغات وإجابته على الأسئلة، ولسجله هو فقط.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@uomosul[.]edu[.]iq$');
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function adminsPath() { return /databases/$(database)/documents/config/admins; }
    function isAdmin() {
      return signedIn() && exists(adminsPath()) && myEmail() in get(adminsPath()).data.emails;
    }
    function ownsTeacher(tid) {
      let path = /databases/$(database)/documents/teachers/$(tid);
      return signedIn() && exists(path) && get(path).data.get('email', '').lower() == myEmail();
    }

    // الصلاحيات المحدودة: { roles: { "<email>": "secretary" | "timetable" | "grad" } } يمنحها رئيس القسم
    function rolesPath() { return /databases/$(database)/documents/config/roles; }
    function hasRole(r) {
      return signedIn() && exists(rolesPath()) && get(rolesPath()).data.get('roles', {}).get(myEmail(), '') == r;
    }
    function onlyStateKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    match /config/roles {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // قائمة المشرفين. أول مستخدم جامعي يمكنه إنشاؤها بحسابه فقط، ثم يديرها المشرفون.
    match /config/admins {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.emails == [myEmail()];
      allow update: if isAdmin() && request.resource.data.emails.size() > 0;
    }

    // بيانات القسم المشتركة
    match /{col}/{id} {
      allow read: if signedIn()
        && col in ['teachers', 'announcements', 'courses', 'invigilation', 'tasks', 'committees', 'polls', 'meta'];
      allow write: if isAdmin()
        && col in ['teachers', 'announcements', 'courses', 'invigilation', 'tasks', 'committees', 'polls', 'meta'];
      // مقرر القسم: التبليغات ومرفقاتها والتكليفات واللجان والأسئلة. مسؤول الجداول: المواد والمراقبات
      allow write: if (hasRole('secretary') && (col in ['announcements', 'tasks', 'committees', 'polls'] || (col == 'meta' && id.matches('f_.*'))))
        || (hasRole('timetable') && col in ['courses', 'invigilation']);
      // كل صلاحية تعدّل مفاتيحها فقط من الحالة المشتركة meta/state
      allow update: if col == 'meta' && id == 'state' && (
        (hasRole('secretary') && onlyStateKeys(['letters', 'letterCfg', 'grad']))
        || (hasRole('timetable') && onlyStateKeys(['schedule', 'ttSections', 'examPlan', 'ttPlans', 'ttTerm', 'scheduleStale']))
        || (hasRole('grad') && onlyStateKeys(['grad'])));
    }

    // البحوث الأكاديمية: يقرؤها كل حساب جامعي، ويضيف التدريسي بحوثه ويعدّلها ويحذفها، والمشرفون للجميع
    match /research/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownsTeacher(request.resource.data.teacher);
      allow update: if isAdmin() || (ownsTeacher(resource.data.teacher) && ownsTeacher(request.resource.data.teacher));
      allow delete: if isAdmin() || ownsTeacher(resource.data.teacher);
    }

    // نقاط الاسترجاع التلقائية: لرئيس القسم والمشرفين فقط
    match /backups/{id} {
      allow read, write: if isAdmin();
    }

    // سجل التغييرات: يكتب كل مستخدم سجل تعديلاته باسمه، ويقرؤه المشرفون، ولا يُعدَّل ولا يُحذف أبداً
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.email == myEmail();
    }

    // العبء التدريسي: لرئيس القسم والمشرفين فقط
    match /workloads/{id} {
      allow read, write: if isAdmin();
    }

    // تأكيد قراءة التبليغات: المعرّف = رقم التبليغ_رقم التدريسي
    match /reads/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (ownsTeacher(request.resource.data.teacher)
            && id == request.resource.data.ann + '_' + request.resource.data.teacher);
      allow update, delete: if isAdmin();
    }

    // إجابات الأسئلة: المعرّف = رقم السؤال_رقم التدريسي
    match /answers/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        || (ownsTeacher(request.resource.data.teacher)
            && id == request.resource.data.poll + '_' + request.resource.data.teacher);
      allow delete: if isAdmin();
    }
  }
}
